services:
  n8n:
    image: n8nio/n8n:latest
    container_name: n8n_illustrator_bridge
    restart: unless-stopped
    ports:
      - "5678:5678"
    volumes:
      - C:/illustrator-automation/n8n_data:/home/node/.n8n
      - C:/illustrator-automation/exchange:/data/exchange
    environment:
      - TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
      - BRIDGE_API_KEY=secret_key_here
      - BRIDGE_JOB_TIMEOUT_SECONDS=300
      - TZ=Europe/Moscow
      - N8N_RESTRICT_FILE_ACCESS_TO=/data/exchange/
      - N8N_BLOCK_ENV_ACCESS_IN_NODE=false
      - N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=false
      - NODES_EXCLUDE="[]"
      - N8N_HOST=localhost
      - N8N_PORT=5678
      - N8N_PROTOCOL=http
      - NODE_FUNCTION_ALLOW_BUILTIN=fs,path
      - NODE_FUNCTION_ALLOW_EXTERNAL=fs-extra
    extra_hosts:
      - "host.docker.internal:host-gateway"