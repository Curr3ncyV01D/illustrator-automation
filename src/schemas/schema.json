{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Illustrator Automation Command Schema",
  "description": "Схема команд для автоматизации Adobe Illustrator через ExtendScript",
  "type": "object",
  "required": ["version", "operations"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Версия протокола (например, '1.0')",
      "enum": ["1.0"]
    },
    "targetFile": {
      "type": "string",
      "description": "Имя целевого файла в папке source_files (опционально)"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "description": "Список операций для выполнения",
      "items": {
        "type": "object",
        "required": ["id", "type", "parameters"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Уникальный ID операции (для зависимостей)"
          },
          "type": {
            "type": "string",
            "enum": ["resize", "move", "replaceObject", "createConfectionCard", "color"],
            "description": "Тип операции"
          },
          "target": {
            "type": "string",
            "description": "Имя целевого объекта (обязательно для resize, move, color)"
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Список ID операций, которые должны быть выполнены перед этой"
          },
          "parameters": {
            "type": "object",
            "description": "Параметры, специфичные для типа операции",
            "oneOf": [
              { "$ref": "#/definitions/resizeParams" },
              { "$ref": "#/definitions/moveParams" },
              { "$ref": "#/definitions/replaceParams" },
              { "$ref": "#/definitions/confectionCardParams" },
              { "$ref": "#/definitions/colorParams" }
            ]
          }
        },
        "if": { "properties": { "type": { "enum": ["resize", "move", "color"] } } },
        "then": { "required": ["target"] }
      }
    }
  },
  "definitions": {
    "resizeParams": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/definitions/dimension" },
        "height": { "$ref": "#/definitions/dimension" }
      },
      "additionalProperties": false
    },
    "moveParams": {
      "type": "object",
      "properties": {
        "x": { "$ref": "#/definitions/dimension" },
        "y": { "$ref": "#/definitions/dimension" },
        "mode": { "type": "string", "enum": ["absolute", "relative"], "default": "absolute" }
      },
      "additionalProperties": false
    },
    "replaceParams": {
      "type": "object",
      "required": ["target", "libraryFile", "sourceObject"],
      "properties": {
        "target": { "type": "string" },
        "libraryFile": {
          "type": "string",
          "description": "Имя файла библиотеки компонентов"
        },
        "sourceObject": {
          "type": "string",
          "description": "Имя объекта-компонента"
        },
        "keepSize": { "type": "boolean", "default": false },
        "keepPosition": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "confectionCardParams": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "sort", "pattern_qty", "cut_qty"],
            "properties": {
              "name": { "type": "string" },
              "sort": { "type": "number" },
              "pattern_qty": { "type": "number" },
              "cut_qty": { "type": "number" },
              "material": { "type": "string" },
              "size": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "template": { "type": "string" },
            "fontSize": { "type": "number" },
            "rowHeight": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "colorParams": {
      "type": "object",
      "properties": {
        "fill": { "type": "object" },
        "stroke": { "type": "object" }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["value", "action"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["mm", "cm", "pt", "px", "in"] },
        "action": { "type": "string", "enum": ["set", "increase", "decrease"] }
      }
    }
  }
}
