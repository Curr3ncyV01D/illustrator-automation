{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Illustrator Automation Command Schema",
  "description": "Главная схема команд для автоматизации Adobe Illustrator",
  "type": "object",
  "required": ["version", "targetFile", "operations"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Версия протокола (например, '1.0')"
    },
    "targetFile": {
      "type": "string",
      "description": "Имя целевого файла в папке source_files"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "description": "Список операций для выполнения",
      "items": {
        "oneOf": [
          { "$ref": "resize.schema.json" },
          { "$ref": "move.schema.json" },
          { "$ref": "replaceObject.schema.json" },
          { "$ref": "createConfectionCard.schema.json" }
        ]
      }
    },
    "metadata": {
      "$ref": "common.json#/definitions/metadata",
      "description": "Метаданные запроса"
    }
  },
  "additionalProperties": false
}
